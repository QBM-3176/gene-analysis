^SAMPLE = GSM7073816
!Sample_title = WT 1
!Sample_geo_accession = GSM7073816
!Sample_status = Public on Sep 01 2023
!Sample_submission_date = Mar 01 2023
!Sample_last_update_date = Sep 01 2023
!Sample_type = SRA
!Sample_channel_count = 1
!Sample_source_name_ch1 = kidney
!Sample_organism_ch1 = Mus musculus
!Sample_taxid_ch1 = 10090
!Sample_characteristics_ch1 = tissue: kidney
!Sample_characteristics_ch1 = cell type: primary cell
!Sample_characteristics_ch1 = genotype: WT
!Sample_characteristics_ch1 = treatment: none
!Sample_treatment_protocol_ch1 = Col4a3-/- mice were treated with food admix of either vehicle, 10 mg/kg ramipril, 10 mg/kg ramipril plus 30 mg/kg empagliflozin, and 10 mg/kg ramipril plus 30 mg/kg empagliflozin plus 10 mg/kg finerenone. The different types of food preparations were marked by different food colors starting from 6 weeks of age for 8 weeks.
!Sample_molecule_ch1 = total RNA
!Sample_extract_protocol_ch1 = Total RNA was isolated using an RNA extraction kit (Life Technologies, Darmstadt, Germany) according to the manufacturer´s instructions, and RNA quality was assessed using agarose gels. RNA-seq of total RNA samples was conducted on the Illumina DNBSEQ-G400 platform, producing 100bp paired-end reads.
!Sample_extract_protocol_ch1 = Strand-specific transcriptome library construction is completed by enriching mRNA from total RNA, sequenced by DNBSEQ high-throughput platform, and followed by bioinformatics analysis.
!Sample_description = WT_1
!Sample_data_processing = After QC, Fastq was mapped to the mm39 by hisat2. DESeq2 for downstream analyze.
!Sample_data_processing = Assembly: mm39
!Sample_data_processing = Supplementary files format and content: count, rpkm matrix
